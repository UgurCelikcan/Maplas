# --- DATABASE CONFIGURATION ---
DB_HOST=db             # Docker kullanıyorsanız 'db', VDS yerel ise 'localhost'
DB_PORT=5432
DB_USER=maplas_user
DB_PASSWORD=your_secure_password_here
DB_NAME=maplas_db

# --- BACKEND SECURITY ---
JWT_SECRET=change_this_to_a_very_long_random_string_2026
ADMIN_SECRET=Maplas-Admin-Secure-Code-2026

# --- SERVER CONFIGURATION ---
SERVER_PORT=8080

# --- FRONTEND (Vite) ---
# VDS IP adresinizi veya domaininizi buraya yazın
VITE_API_URL=http://your-vds-ip-or-domain:8080
