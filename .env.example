# --- DATABASE CONFIGURATION ---
DB_HOST=db             # Docker kullanıyorsanız 'db', VDS yerel ise 'localhost'
DB_PORT=5432
DB_USER=maplas_user
DB_PASSWORD=your_secure_password_here
DB_NAME=maplas_db

# --- BACKEND SECURITY ---
# Zorunlu: boş bırakılırsa backend başlamaz. Bu dosyadaki örnek değerleri KULLANMAYIN.
# Rastgele değer üretmek için: openssl rand -hex 32
# JWT_SECRET: en az 32 karakter, rastgele
JWT_SECRET=
# ADMIN_SECRET: admin kaydı için davet kodu, gizli tutun
ADMIN_SECRET=

# --- SERVER CONFIGURATION ---
SERVER_PORT=8080

# --- FRONTEND (Vite) ---
# VDS IP adresinizi veya domaininizi buraya yazın
VITE_API_URL=http://your-vds-ip-or-domain:8080
