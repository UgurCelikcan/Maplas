(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

# Access logs contain IP addresses (personal data under KVKK):
# rotate at 10 MB and delete after 30 days.
(access_log) {
    log {
        output file /var/log/caddy/{args[0]}.log {
            roll_size 10MiB
            roll_keep 10
            roll_keep_for 720h
        }
    }
}

www.maplas.net {
    redir https://maplas.net{uri} permanent
}

maplas.net {
    import security_headers
    import access_log frontend_access
    encode gzip zstd

    # Build files have a hash in their name, so browsers can keep them for a year.
    @hashed path /assets/*
    header @hashed Cache-Control "public, max-age=31536000, immutable"
    # The page itself and the service worker must always be checked for updates.
    @fresh path / /index.html /sw.js /registerSW.js /manifest.webmanifest
    header @fresh Cache-Control "no-cache"

    root * /usr/share/caddy
    file_server
    try_files {path} /index.html

    # Uploaded images are served by the backend
    reverse_proxy /uploads/* backend:8080
}

api.maplas.net {
    import security_headers
    import access_log api_access
    encode gzip zstd

    # Backend Proxy
    reverse_proxy * backend:8080
}
